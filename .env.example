# ==========================================================
# MediAccess AI — example environment configuration
# Copy this file to `.env` and adjust the values.
# NEVER put real secrets in this file. NEVER commit `.env`.
# ==========================================================

# ---------- Backend ----------
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Set to "development" locally; use "production" when deployed
APP_ENV=development
# Allowed browser origin for CORS (frontend dev server)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- MongoDB (used from Stage 5 onward) ----------
# Local Docker MongoDB default:
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=medaccess

# ---------- Authentication / JWT (used from Stage 5 onward) ----------
# Generate a strong value, e.g.: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=replace-with-a-long-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ---------- AI / LLM provider (used from Stage 7 onward) ----------
# Leave LLM_API_KEY empty to use the deterministic fallback parser locally.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=

# ---------- Frontend (Vite) ----------
# Base URL of the FastAPI backend used by the React app
VITE_API_BASE_URL=http://127.0.0.1:8000

# ---------- Database seeding ----------
SEED_BATCH_SIZE=50
